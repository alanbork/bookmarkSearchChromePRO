{
  "manifest_version": 4,
  "name": "Bookmark Searcher, PRO",
  "version": "4.0",
  "description": "A Chrome extension to quickly search your bookmarks (alt+b). Left click to update bookmark to current page (or delete entirely).",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
       "48": "icon.png"
     }
  },
  "permissions": [
    "bookmarks",
    "tabs",
    "history",
    "storage"
  ],
  "commands": {
   "_execute_action": {
       "suggested_key": {
         "default": "Alt+B"
       },
       "description": "Open Bookmark Search"
    }
  }
}